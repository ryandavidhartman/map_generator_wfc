{
  "name": "wfc-hex-crawl-generator",
  "private": true,
  "license": "CC-BY-SA-4.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/simulate.mjs --log-level=warning && node node_modules/.tmp/simulate.mjs",
    "town-maps": "esbuild scripts/townMaps.ts --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=node_modules/.tmp/townMaps.mjs --log-level=warning && node node_modules/.tmp/townMaps.mjs"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
